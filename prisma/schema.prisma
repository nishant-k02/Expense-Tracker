generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Single-row profile for the app's one user. Always read/written by the
// fixed id "singleton" — see src/lib/profile.ts.
model Profile {
  id            String   @id @default("singleton")
  name          String?
  // Small avatar image stored inline as a data URL (data:image/...;base64,...).
  // Fine at single-user scale; avoids standing up separate blob storage.
  avatarDataUrl String?
  updatedAt     DateTime @updatedAt
}

model Item {
  id               String    @id @default(cuid())
  plaidItemId      String    @unique
  plaidAccessToken String    // AES-256-GCM encrypted ciphertext, never plaintext
  institutionId    String
  institutionName  String
  cursor           String?   // transactionsSync cursor, null until first sync
  status           String    @default("active") // active | error | pending_expiration
  error            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  accounts         Account[]
}

model Account {
  id               String        @id @default(cuid())
  itemId           String
  item             Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  plaidAccountId   String        @unique
  name             String
  officialName     String?
  mask             String?
  type             String        // depository | credit | loan | investment
  subtype          String?       // checking | savings | credit card | ...
  currentBalance   Decimal?      @db.Decimal(14, 2)
  availableBalance Decimal?      @db.Decimal(14, 2)
  isoCurrencyCode  String?       @default("USD")
  hidden           Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transactions     Transaction[]
  subscriptions    Subscription[]
}

model Subscription {
  id              String    @id @default(cuid())
  name            String
  // Which email account the subscription itself is under (e.g. Apple ID,
  // Google account) — not derivable from bank data, so purely user-set.
  billingEmail    String?
  amount          Decimal?  @db.Decimal(10, 2)
  currency        String?   @default("USD")
  frequency       String?   // weekly | biweekly | monthly | quarterly | annually | unknown
  nextDueDate     DateTime? @db.Date
  lastChargedDate DateTime? @db.Date
  accountId       String?
  account         Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryName    String?
  isActive        Boolean   @default(true)
  source          String    @default("manual") // manual | detected
  // "investment" (e.g. a Robinhood recurring buy) is tracked here for
  // visibility but must never be summed into subscription cost totals —
  // it's a different category of recurring outflow, not a service subscription.
  type            String    @default("subscription") // subscription | investment
  // Stable identity for a detected candidate (merchant+amount), independent of
  // display `name` — lets the user rename a detected row (e.g. "Apple ($6.97)"
  // -> "Apple Music") without re-detection recreating a duplicate under the
  // original name on the next sync. Null for manual/investment rows.
  detectionKey    String?
  // Once the user edits a detected row (or creates one manually), re-running
  // detection must not silently overwrite their changes.
  overridden      Boolean   @default(false)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([accountId, detectionKey])
}

model Category {
  id                String        @id @default(cuid())
  name              String        @unique
  plaidPrimary      String?       @unique
  icon              String?
  isDefault         Boolean       @default(false)
  // True for categories that represent money moving between the user's own
  // accounts (transfers, credit card bill payments) rather than real income
  // or spending. Excluded from dashboard totals to avoid double-counting.
  excludeFromTotals Boolean       @default(false)
  transactions      Transaction[]
}

model Transaction {
  id                   String      @id @default(cuid())
  accountId            String
  account              Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plaidTransactionId   String      @unique
  amount               Decimal     @db.Decimal(14, 2) // Plaid convention: positive = money out, negative = inflow
  isoCurrencyCode      String?     @default("USD")
  date                 DateTime    @db.Date
  authorizedDate       DateTime?   @db.Date
  merchantName         String?
  name                 String
  pending              Boolean     @default(false)
  plaidCategoryPrimary String?
  plaidCategoryDetailed String?
  categoryId           String?
  category             Category?   @relation(fields: [categoryId], references: [id])
  categoryOverridden   Boolean     @default(false)
  // True when this transaction has been matched to an equal-and-opposite
  // transaction in another of the user's own linked accounts (e.g. a Chase
  // -> PNC transfer), as opposed to a payment to/from someone else. Computed
  // by detectInternalTransfers(); excluded from dashboard totals.
  isInternalTransfer   Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([date])
  @@index([accountId, date])
  @@index([categoryId])
}
