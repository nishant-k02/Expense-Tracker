# Postgres connection string (local dev container, or Vercel/Neon in production)
DATABASE_URL="postgresql://expense_tracker:devpassword@localhost:5433/expense_tracker"

# Plaid (get free Sandbox keys at https://dashboard.plaid.com)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Set after deploying: https://<your-deployment>/api/plaid/webhook
PLAID_WEBHOOK_URL=

# 32-byte hex key used to encrypt Plaid access tokens at rest. Generate with:
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# The only account allowed to log in
ALLOWED_USER_EMAIL=nishantsk2002@gmail.com
# bcrypt hash of your chosen password. Generate with:
#   pnpm tsx scripts/hash-password.ts "your-password-here"
# IMPORTANT: escape every $ as \$ here — Next.js's env loader does shell-style
# $VAR expansion on .env files, which silently corrupts bcrypt hashes otherwise.
AUTH_PASSWORD_HASH=

# NextAuth signing secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Shared secret Vercel Cron sends to /api/cron/sync (any random string)
CRON_SECRET=
